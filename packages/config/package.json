{
  "name": "@talaqi/config",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./tsconfig.json": "./tsconfig.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --allowJs --checkJs --module NodeNext --moduleResolution NodeNext --target ES2022 eslint/index.mjs eslint.config.mjs",
    "build": "node --check eslint/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
