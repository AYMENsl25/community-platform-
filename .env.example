# Copy to .env for local development only. Every secret below is intentionally unusable in production.
# Staging/production must override URLs, origins, hosts, secrets, cookies, MFA, and all connections.
ENVIRONMENT=development
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SESSION_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_ONLY_SESSION_SECRET
CURRENT_TERMS_VERSION=2026-07-11
CURRENT_PRIVACY_VERSION=2026-07-11
COOKIE_SECURE=false
ADMIN_MFA_REQUIRED=false
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_ONLY_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://talaqi:REPLACE_WITH_A_LOCAL_ONLY_POSTGRES_PASSWORD@localhost:5432/talaqi  # pragma: allowlist secret
# Destructive migration/test tooling rejects every non-loopback, missing-port, or non-_test target.
TEST_DATABASE_URL=postgresql+asyncpg://talaqi_test_user:REPLACE_WITH_A_SEPARATE_LOCAL_TEST_PASSWORD@127.0.0.1:5432/talaqi_test  # pragma: allowlist secret
MINIO_ROOT_USER=REPLACE_WITH_A_LOCAL_ONLY_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LOCAL_ONLY_MINIO_PASSWORD
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talaqi-local
S3_ACCESS_KEY=REPLACE_WITH_A_LOCAL_ONLY_MINIO_USER
S3_SECRET_KEY=REPLACE_WITH_A_LOCAL_ONLY_MINIO_PASSWORD
SMTP_HOST=localhost
SMTP_PORT=1025
LOG_LEVEL=DEBUG
