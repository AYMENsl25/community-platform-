{
  "name": "talaqi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23",
      "nanoid@<3.3.18": "3.3.18",
      "next>sharp": "0.35.3"
    }
  },
  "scripts": {
    "format:check": "prettier --check .",
    "brand:generate": "node scripts/brand/generate-assets.mjs",
    "brand:check": "node scripts/brand/generate-assets.mjs --check",
    "lint": "corepack pnpm --recursive --if-present lint",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "build": "corepack pnpm --recursive --if-present build",
    "openapi:generate": "corepack pnpm --filter @talaqi/api-client generate",
    "openapi:check": "corepack pnpm --filter @talaqi/api-client generate:check",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.3",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
