{
  "name": "talaqi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "corepack pnpm --recursive --if-present lint",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "build": "corepack pnpm --recursive --if-present build",
    "openapi:generate": "corepack pnpm --filter @talaqi/api-client generate",
    "openapi:check": "corepack pnpm --filter @talaqi/api-client generate:check",
    "e2e": "node -e \"console.log('Playwright will be added with the first critical journey; no browsers required yet.')\""
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  }
}
