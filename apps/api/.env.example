ENVIRONMENT=development
APP_NAME=COMMUNITI API
API_V1_PREFIX=/api/v1

# Local PostgreSQL connection. Use separate fields so passwords do not need URL encoding.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=communiti_dev
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Optional full URL for deployments. If set, it overrides DB_* fields.
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5433/communiti_dev

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json

# Clerk auth. Google login is configured inside Clerk.
# Example issuer: https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_ISSUER=
# Optional. If empty, the API uses CLERK_ISSUER + /.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_AUDIENCE=
# Optional. Defaults to ALLOWED_ORIGINS. Used to validate the Clerk azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Web origin used for payment return URLs.
WEB_BASE_URL=http://127.0.0.1:3000

# Payment checkout. Moyasar is the first target for Saudi/MENA checkout.
PAYMENT_PROVIDER=moyasar
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
# Leave empty for local dev fallback checkout.
MOYASAR_SECRET_KEY=
# Configure this in Moyasar Dashboard -> Settings -> Webhooks.
MOYASAR_WEBHOOK_SECRET=
